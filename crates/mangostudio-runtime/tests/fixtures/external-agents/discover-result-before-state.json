                  {
                    "type": "string",
                    "const": "sign-in"
                  },
                  {
                    "type": "string",
                    "const": "contact-admin"
                  },
                  {
                    "type": "string",
                    "const": "accept-disclosure"
                  },
                  {
                    "type": "string",
                    "const": "none"
