              {
                "type": "string",
                "const": "runtime-unsupported"
              },
              {
                "type": "string",
                "const": "runtime-denied"
              },
              {
                "type": "string",
                "const": "environment-unreachable"
              },
              {
                "type": "string",
                "const": "isolation-unproven"
              },
              {
                "type": "string",
                "const": "version-unsupported"
              },
              {
                "type": "string",
                "const": "disclosure-required"
              },
              {
                "type": "string",
                "const": "installed-but-unusable"
              }
