              "modelCatalog": {
                "type": "boolean"
              },
              "images": {
                "type": "boolean"
              },
              "usageReporting": {
                "type": "boolean"
              },
              "cancellation": {
                "type": "boolean"
              },
              "steering": {
                "type": "boolean"
              },
              "sessionListing": {
                "type": "boolean"
