{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "formatter": {
    "prettier": { "disabled": true },
    "bun-fmt": {
      "command": ["bun", "fmt", "$FILE"],
      "extensions": [
        ".js",
        ".jsx",
        ".mjs",
        ".cjs",
        ".ts",
        ".tsx",
        ".mts",
        ".cts",
        ".json",
        ".jsonc",
        ".css",
        ".html",
        ".md",
        ".mdc",
        ".mdx",
        ".toml",
        ".yml",
        ".yaml"
      ]
    }
  }
}
