{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "formatter": {
    "prettier": { "disabled": true },
    "biome-fix": {
      "command": [
        "./node_modules/.bin/biome",
        "check",
        "--write",
        "--no-errors-on-unmatched",
        "--files-ignore-unknown=true",
        "$FILE"
      ],
      "extensions": [
        ".js",
        ".jsx",
        ".mjs",
        ".cjs",
        ".ts",
        ".tsx",
        ".mts",
        ".cts",
        ".json",
        ".jsonc",
        ".css",
        ".html"
      ]
    },
    "dprint-fmt": {
      "command": ["./node_modules/.bin/dprint", "fmt", "--allow-no-files", "$FILE"],
      "extensions": [".md", ".mdx", ".toml", ".yml", ".yaml"]
    }
  }
}
