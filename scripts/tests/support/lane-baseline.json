{
  "base": "acf8930f",
  "commands": {
    "ci": {},
    "cargo-shim": {
      "workspace": [
        "cargo fmt --all -- --check",
        "cargo check --workspace --locked",
        "cargo check --workspace --all-targets --all-features --locked",
        "cargo check -p mangostudio --all-targets --locked",
        "cargo clippy -p mangostudio --all-targets --locked -- -D warnings",
        "cargo test -p mangostudio --all-targets --locked",
        "cargo clippy --workspace --all-targets --all-features --locked -- -D warnings",
        "cargo nextest run --workspace --all-targets --all-features --locked --retries 0",
        "bun scripts/bench/rust-test-inventory.ts capture \"$RUNNER_TEMP/libtest.json\"",
        "bun scripts/bench/rust-test-inventory.ts capture-nextest \"$RUNNER_TEMP/nextest.json\"",
        "bun scripts/bench/rust-test-inventory.ts compare \"$RUNNER_TEMP/libtest.json\" \"$RUNNER_TEMP/nextest.json\"",
        "cargo test --doc --workspace --all-features --locked",
        "cargo doc --no-deps --workspace --all-features --locked",
        "cargo build --workspace --locked"
      ],
      "workspace-windows-arm64": [
        "cargo check --workspace --all-targets --all-features --locked --target aarch64-pc-windows-msvc",
        "cargo check -p mangostudio --all-targets --locked --target aarch64-pc-windows-msvc",
        "cargo nextest run -p mangostudio-runtime --all-targets --all-features --locked --retries 0"
      ],
      "musl-clippy": [
        "cargo-zigbuild clippy --locked -p mangostudio-runtime --all-targets --target x86_64-unknown-linux-musl -- -D warnings",
        "cargo-zigbuild clippy --locked -p mangostudio-runtime --all-targets --target aarch64-unknown-linux-musl -- -D warnings"
      ],
      "fuzz-workspace": [
        "cargo metadata --manifest-path crates/mango-protocol/fuzz/Cargo.toml --locked --all-features --format-version 1 > /dev/null"
      ],
      "runtime-home-fixture-freshness": [
        "cargo test -p mangostudio-runtime --test generate_rust_fixture --locked -- --ignored"
      ],
      "real-binary-qualification": [
        "cargo build -p mangostudio-runtime --locked",
        "cargo build -p mangostudio-runtime --example fake_cursor_agent --locked",
        "bun ./scripts/ci/rust-lanes.ts qualify --suite integration",
        "bun ./scripts/ci/rust-lanes.ts qualify --suite unit"
      ]
    },
    "protocol-ci": {
      "typescript": ["bun run protocol:check --ts-only", "bun run protocol:test --ts-only"],
      "package": ["bun ./scripts/protocol/verify-package.ts"],
      "rust": [
        "cargo hack clippy -p mango-protocol --feature-powerset --all-targets --locked -- -D warnings",
        "cargo test -p mango-protocol --doc --all-features --locked",
        "cargo doc -p mango-protocol --no-deps --all-features --locked"
      ],
      "transports": ["bun run protocol:test --ts-only"],
      "interop": [
        "cargo build --locked --example conformance_peer --features testing,websocket,spawn",
        "bun test packages/protocol/tests/interop"
      ],
      "deny": ["cargo deny check"],
      "semver-checks": ["cargo semver-checks check-release --all-features"],
      "schema-equality": [
        "bun ./scripts/protocol/verify-schema-equality.ts",
        "bun ./scripts/protocol/verify-roundtrip.ts"
      ]
    },
    "release-dry-run": {
      "dry-run-cargo": [
        "cargo publish --dry-run --locked --manifest-path crates/mangostudio-launcher/Cargo.toml"
      ]
    },
    "rust-fresh-dependencies": {
      "resolve": ["cargo generate-lockfile"],
      "policy": ["cargo deny check bans licenses sources"],
      "fresh": [
        "cargo clippy --workspace --all-targets --all-features --locked -- -D warnings",
        "cargo test --workspace --all-targets --all-features --locked",
        "cargo test --doc --workspace --all-features --locked"
      ]
    },
    "rust-coverage": {
      "coverage": [
        "cargo llvm-cov --no-report --workspace --all-targets --all-features --locked || status=$?",
        "cargo llvm-cov report --json --summary-only --output-path qa-rust-coverage/llvm-cov.json"
      ]
    }
  },
  "gates": {
    "ci": {
      "needs": [
        "distribution-identity",
        "changes",
        "distribution",
        "check",
        "local-runtime",
        "test",
        "build",
        "rust-coverage",
        "browser-smoke",
        "qa-metrics",
        "smoke",
        "smoke-container"
      ],
      "skips": "${{ format('{0} {1} {2} {3} {4}',\n            github.event_name == 'workflow_dispatch' && 'qa-metrics' || '',\n            needs.changes.outputs.distribution == 'false' && 'distribution' || '',\n            needs.changes.outputs.distribution == 'false' && 'smoke' || '',\n            needs.changes.outputs.distribution == 'false' && 'smoke-container' || '',\n            needs.changes.outputs.rust == 'false' && 'rust-coverage' || '') }}"
    },
    "cargo-shim": {
      "needs": [
        "changes",
        "workspace",
        "workspace-windows-arm64",
        "musl-clippy",
        "fuzz-workspace",
        "runtime-home-fixture-freshness",
        "real-binary-qualification"
      ],
      "skips": "${{ format('{0} {1}', needs.changes.outputs.rust == 'false' && 'workspace workspace-windows-arm64 musl-clippy fuzz-workspace runtime-home-fixture-freshness' || '', needs.changes.outputs.qualification == 'false' && 'real-binary-qualification' || '') }}"
    },
    "protocol-ci": {
      "needs": [
        "changes",
        "typescript",
        "package",
        "rust",
        "transports",
        "interop",
        "deny",
        "semver-checks",
        "schema-equality"
      ],
      "skips": "${{ needs.changes.outputs.protocol == 'false' && 'typescript package rust transports interop deny semver-checks schema-equality' || '' }}"
    },
    "release-dry-run": {
      "needs": ["changes", "runtime", "dry-run-linux", "dry-run-windows", "dry-run-cargo"],
      "skips": "${{ format('{0} {1} {2} {3}', needs.changes.outputs.release == 'false' && 'dry-run-linux' || '', needs.changes.outputs.launcher == 'false' && 'dry-run-cargo' || '', needs.changes.outputs.release == 'false' && 'dry-run-windows' || '', needs.changes.outputs.release == 'false' && 'runtime' || '') }}"
    }
  },
  "policies": {
    "protocol": "^(packages/protocol/|crates/mango-protocol/|spec/|docs/protocol/|scripts/protocol/|Cargo\\.(toml|lock)$|deny\\.toml$|rustfmt\\.toml$|rust-toolchain\\.toml$|scripts/lib/protocol\\.ts$|\\.github/workflows/protocol-ci\\.yml$)",
    "distribution": "^(docs/|\\.github/ISSUE_TEMPLATE/|\\.github/(CODE_OF_CONDUCT|CONTRIBUTING|SECURITY|pull_request_template)\\.md$|[^/]*\\.md$|LICENSE$)",
    "release": "^(\\.github/workflows/release[^/]*\\.yml$|\\.github/workflows/canary\\.yml$|\\.github/workflows/runtime-build\\.yml$|scripts/release/|scripts/install/|scripts/tests/install-ps1-layout\\.unit\\.test\\.ts$|scripts/tests/support/windows-user-path\\.ts$|scripts/build(-runtime)?\\.ts$|scripts/lib/|packages/cli/|crates/(mangostudio-launcher|mangostudio-runtime|mangostudio-runtime-contract|mango-protocol)/|Cargo\\.(toml|lock)$|rust-toolchain\\.toml$|\\.cargo/config\\.toml$|\\.github/actions/setup-zigbuild/|Dockerfile$)",
    "launcher": "^(crates/mangostudio-launcher/|Cargo\\.(toml|lock)$|rust-toolchain\\.toml$|\\.github/workflows/release(-dry-run)?\\.yml$|scripts/release/verify-launcher-package\\.sh$)"
  },
  "rustPaths": {
    "workspace": [
      "crates/**",
      "apps/shared/src/runtime-contract/**",
      "apps/shared/src/runtime-home/**",
      "apps/shared/src/external-agents/**",
      "apps/shared/src/schema-helpers.ts",
      "apps/shared/src/environments/toolchain-schemas.ts",
      "apps/shared/src/library/**",
      "apps/shared/src/markdown/**",
      "apps/api/src/modules/external-agents/application/external-session-manager.ts",
      "apps/api/src/modules/external-agents/domain/adapter-descriptors.ts",
      "spec/**",
      "scripts/tests/support/SHA256SUMS.sample",
      "packages/protocol/src/testing/conformance.ts",
      "Cargo.toml",
      "Cargo.lock",
      "deny.toml",
      "rustfmt.toml",
      "rust-toolchain.toml",
      ".cargo/config.toml",
      ".github/workflows/cargo-shim.yml",
      ".github/workflows/rust-coverage.yml",
      ".github/actions/setup-zigbuild/**",
      "scripts/bench/rust-test-inventory.ts"
    ],
    "qualification": [
      "crates/**",
      "apps/shared/src/runtime-contract/**",
      "apps/shared/src/runtime-home/**",
      "apps/shared/src/external-agents/**",
      "apps/shared/src/schema-helpers.ts",
      "apps/shared/src/environments/toolchain-schemas.ts",
      "apps/shared/src/library/**",
      "apps/shared/src/markdown/**",
      "apps/api/src/modules/external-agents/application/external-session-manager.ts",
      "apps/api/src/modules/external-agents/domain/adapter-descriptors.ts",
      "spec/**",
      "scripts/tests/support/SHA256SUMS.sample",
      "packages/protocol/src/testing/conformance.ts",
      "Cargo.toml",
      "Cargo.lock",
      "deny.toml",
      "rustfmt.toml",
      "rust-toolchain.toml",
      ".cargo/config.toml",
      ".github/workflows/cargo-shim.yml",
      ".github/workflows/rust-coverage.yml",
      ".github/actions/setup-zigbuild/**",
      "scripts/bench/rust-test-inventory.ts",
      "apps/api/**",
      "apps/shared/**",
      "package.json",
      "bun.lock",
      ".bun-version",
      "patches/**",
      "packages/protocol/**",
      "scripts/lib/rust-lanes.ts",
      "scripts/ci/rust-lanes.ts"
    ]
  }
}
