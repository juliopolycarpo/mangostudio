{
  "tab_size": 2,
  "hard_tabs": false,
  "preferred_line_length": 100,
  "format_on_save": "on",
  "remove_trailing_whitespace_on_save": true,
  "ensure_final_newline_on_save": true,
  "auto_indent_on_paste": true,
  "inlay_hints": {
    "enabled": true,
    "show_type_hints": true,
    "show_parameter_hints": true,
    "show_other_hints": true
  },
  "file_types": { "Markdown": ["mdc", "mdx"] },
  "languages": {
    "TypeScript": {
      "formatter": {
        "external": { "command": "bun", "arguments": ["fmt", "--stdin-filepath", "{buffer_path}"] }
      }
    },
    "TSX": {
      "formatter": {
        "external": { "command": "bun", "arguments": ["fmt", "--stdin-filepath", "{buffer_path}"] }
      }
    },
    "JavaScript": {
      "formatter": {
        "external": { "command": "bun", "arguments": ["fmt", "--stdin-filepath", "{buffer_path}"] }
      }
    },
    "JSON": {
      "formatter": {
        "external": { "command": "bun", "arguments": ["fmt", "--stdin-filepath", "{buffer_path}"] }
      }
    },
    "JSONC": {
      "formatter": {
        "external": { "command": "bun", "arguments": ["fmt", "--stdin-filepath", "{buffer_path}"] }
      }
    },
    "CSS": {
      "formatter": {
        "external": { "command": "bun", "arguments": ["fmt", "--stdin-filepath", "{buffer_path}"] }
      }
    },
    "Markdown": {
      "formatter": {
        "external": {
          "command": "bun",
          "arguments": ["fmt", "--stdin-filepath", "{buffer_path}"]
        }
      }
    },
    "YAML": {
      "formatter": {
        "external": {
          "command": "bun",
          "arguments": ["fmt", "--stdin-filepath", "{buffer_path}"]
        }
      }
    },
    "TOML": {
      "formatter": {
        "external": {
          "command": "bun",
          "arguments": ["fmt", "--stdin-filepath", "{buffer_path}"]
        }
      }
    },
    "HTML": {
      "formatter": {
        "external": {
          "command": "bun",
          "arguments": ["fmt", "--stdin-filepath", "{buffer_path}"]
        }
      }
    }
  }
}
