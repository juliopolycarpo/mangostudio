{
  "$schema": "https://dprint.dev/schemas/v0.json",
  "lineWidth": 100,
  "indentWidth": 2,
  "newLineKind": "lf",
  "useTabs": false,
  "markdown": {
    "textWrap": "maintain",
    "emphasisKind": "asterisks",
    "strongKind": "asterisks",
    "lineWidth": 100,
    "associations": ["**/*.{md,mdc,mdx}"]
  },
  "toml": {},
  "yaml": {},
  "includes": ["**/*.{md,mdc,mdx,toml,yml,yaml}"],
  "excludes": [
    "**/node_modules",
    "**/dist",
    "**/target",
    "**/coverage",
    "**/CHANGELOG.md",
    "bun.lock"
  ],
  "plugins": [
    "./node_modules/@dprint/markdown/plugin.wasm",
    "./node_modules/@dprint/toml/plugin.wasm",
    "https://plugins.dprint.dev/g-plane/pretty_yaml-v0.6.0.wasm"
  ]
}
