{
  "$comment": "Negotiation cases: effective minor is the lower minor when majors match; otherwise close 4426. The 1.1/1.0 pairs are the wire's first minor bump: a 1.1 peer against a 1.0 one runs at 0 and sends nothing minor 1 added.",
  "handshake": {
    "$comment": "The handshake budget of the wire spec section 5.2: a peer that has not received hello within timeoutMs closes with closeCode and this exact reason.",
    "timeoutMs": 15000,
    "closeCode": 4400,
    "reason": "handshake timeout"
  },
  "cases": [
    {
      "name": "y_equal",
      "local": {
        "major": 1,
        "minor": 0
      },
      "remote": {
        "major": 1,
        "minor": 0
      },
      "expected": {
        "effectiveMinor": 0
      }
    },
    {
      "name": "y_remote_newer",
      "local": {
        "major": 1,
        "minor": 0
      },
      "remote": {
        "major": 1,
        "minor": 3
      },
      "expected": {
        "effectiveMinor": 0
      }
    },
    {
      "name": "y_local_newer",
      "local": {
        "major": 1,
        "minor": 5
      },
      "remote": {
        "major": 1,
        "minor": 2
      },
      "expected": {
        "effectiveMinor": 2
      }
    },
    {
      "name": "y_both_newer_than_zero",
      "local": {
        "major": 1,
        "minor": 2
      },
      "remote": {
        "major": 1,
        "minor": 5
      },
      "expected": {
        "effectiveMinor": 2
      }
    },
    {
      "name": "y_one_one_both_sides",
      "local": {
        "major": 1,
        "minor": 1
      },
      "remote": {
        "major": 1,
        "minor": 1
      },
      "expected": {
        "effectiveMinor": 1
      }
    },
    {
      "name": "y_one_one_against_one_zero",
      "local": {
        "major": 1,
        "minor": 1
      },
      "remote": {
        "major": 1,
        "minor": 0
      },
      "expected": {
        "effectiveMinor": 0
      }
    },
    {
      "name": "y_one_zero_against_one_one",
      "local": {
        "major": 1,
        "minor": 0
      },
      "remote": {
        "major": 1,
        "minor": 1
      },
      "expected": {
        "effectiveMinor": 0
      }
    },
    {
      "name": "n_major_higher",
      "local": {
        "major": 1,
        "minor": 0
      },
      "remote": {
        "major": 2,
        "minor": 0
      },
      "expected": {
        "mismatch": true,
        "closeCode": 4426
      }
    },
    {
      "name": "n_major_lower",
      "local": {
        "major": 2,
        "minor": 1
      },
      "remote": {
        "major": 1,
        "minor": 9
      },
      "expected": {
        "mismatch": true,
        "closeCode": 4426
      }
    }
  ]
}
