{
  "$comment": "Mango Protocol 1 frame conformance corpus. verdict: accept | reject | implementation-defined. line is one NDJSON record without its terminator. expected is a subset match on known members.",
  "cases": [
    {
      "name": "y_hello_minimal",
      "verdict": "accept",
      "line": "{\"type\":\"hello\",\"protocol\":{\"major\":1,\"minor\":0},\"peer\":{\"name\":\"fixture\",\"version\":\"0.0.0\",\"role\":\"tool\"},\"capabilities\":{}}",
      "expected": {
        "type": "hello",
        "protocol": {
          "major": 1,
          "minor": 0
        },
        "peer": {
          "name": "fixture",
          "version": "0.0.0",
          "role": "tool"
        },
        "capabilities": {}
      }
    },
    {
      "name": "y_hello_limits_and_capabilities",
      "verdict": "accept",
      "line": "{\"type\":\"hello\",\"protocol\":{\"major\":1,\"minor\":0},\"peer\":{\"name\":\"fixture\",\"version\":\"0.0.0\",\"role\":\"tool\"},\"capabilities\":{\"fsRead\":true,\"shells\":[\"bash\",\"zsh\"],\"nested\":{\"a\":1}},\"limits\":{\"maxFrameBytes\":4096}}",
      "expected": {
        "type": "hello",
        "protocol": {
          "major": 1,
          "minor": 0
        },
        "peer": {
          "name": "fixture",
          "version": "0.0.0",
          "role": "tool"
        },
        "capabilities": {
          "fsRead": true,
          "shells": [
            "bash",
            "zsh"
          ],
          "nested": {
            "a": 1
          }
        },
        "limits": {
          "maxFrameBytes": 4096
        }
      }
    },
    {
      "name": "y_hello_max_in_flight",
      "verdict": "accept",
      "line": "{\"type\":\"hello\",\"protocol\":{\"major\":1,\"minor\":1},\"peer\":{\"name\":\"fixture\",\"version\":\"0.0.0\",\"role\":\"tool\"},\"capabilities\":{},\"limits\":{\"maxFrameBytes\":65536,\"maxInFlight\":16}}",
      "expected": {
        "type": "hello",
        "limits": {
          "maxFrameBytes": 65536,
          "maxInFlight": 16
        }
      }
    },
    {
      "name": "y_hello_max_in_flight_alone",
      "verdict": "accept",
      "line": "{\"type\":\"hello\",\"protocol\":{\"major\":1,\"minor\":1},\"peer\":{\"name\":\"fixture\",\"version\":\"0.0.0\",\"role\":\"tool\"},\"capabilities\":{},\"limits\":{\"maxInFlight\":1}}",
      "expected": {
        "type": "hello",
        "limits": {
          "maxInFlight": 1
        }
      }
    },
    {
      "name": "n_hello_max_in_flight_zero",
      "verdict": "reject",
      "reason": "schema",
      "line": "{\"type\":\"hello\",\"protocol\":{\"major\":1,\"minor\":1},\"peer\":{\"name\":\"fixture\",\"version\":\"0.0.0\",\"role\":\"tool\"},\"capabilities\":{},\"limits\":{\"maxInFlight\":0}}"
    },
    {
      "name": "n_hello_max_in_flight_not_an_integer",
      "verdict": "reject",
      "reason": "schema",
      "line": "{\"type\":\"hello\",\"protocol\":{\"major\":1,\"minor\":1},\"peer\":{\"name\":\"fixture\",\"version\":\"0.0.0\",\"role\":\"tool\"},\"capabilities\":{},\"limits\":{\"maxInFlight\":1.5}}"
    },
    {
      "name": "y_hello_future_minor",
      "verdict": "accept",
      "line": "{\"type\":\"hello\",\"protocol\":{\"major\":1,\"minor\":7},\"peer\":{\"name\":\"fixture\",\"version\":\"0.0.0\",\"role\":\"tool\"},\"capabilities\":{}}",
      "expected": {
        "type": "hello",
        "protocol": {
          "major": 1,
          "minor": 7
        },
        "peer": {
          "name": "fixture",
          "version": "0.0.0",
          "role": "tool"
        },
        "capabilities": {}
      },
      "note": "Decoding accepts any minor; negotiation happens in the session."
    },
    {
      "name": "y_hello_unknown_members_ignored",
      "verdict": "accept",
      "line": "{\"type\":\"hello\",\"protocol\":{\"major\":1,\"minor\":0},\"peer\":{\"name\":\"fixture\",\"version\":\"0.0.0\",\"role\":\"tool\"},\"capabilities\":{},\"x-vendor\":{\"trace\":\"abc\"},\"future\":1}",
      "expected": {
        "type": "hello",
        "protocol": {
          "major": 1,
          "minor": 0
        },
        "peer": {
          "name": "fixture",
          "version": "0.0.0",
          "role": "tool"
        },
        "capabilities": {}
      },
      "note": "Unknown members are ignored; expected lists known members only."
    },
    {
      "name": "y_req_object_params",
      "verdict": "accept",
      "line": "{\"type\":\"req\",\"id\":\"r-1\",\"method\":\"fs.read-file\",\"params\":{\"path\":\"/etc/hosts\"}}",
      "expected": {
        "type": "req",
        "id": "r-1",
        "method": "fs.read-file",
        "params": {
          "path": "/etc/hosts"
        }
      }
    },
