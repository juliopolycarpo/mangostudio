{
  "$comment": "NDJSON stream decoding cases. pieces are pushed in order; finish: true calls the end-of-stream flush. expected lists the frames delivered before any refusal.",
  "cases": [
    {
      "name": "y_two_frames_one_push",
      "verdict": "accept",
      "pieces": [
        "{\"type\":\"ping\"}\n{\"type\":\"pong\"}\n"
      ],
      "expected": [
        {
          "type": "ping"
        },
        {
          "type": "pong"
        }
      ]
    },
    {
      "name": "y_crlf_terminator",
      "verdict": "accept",
      "pieces": [
        "{\"type\":\"ping\"}\r\n"
      ],
      "expected": [
        {
          "type": "ping"
        }
      ]
    },
    {
      "name": "y_crlf_terminator_at_the_limit",
      "verdict": "accept",
      "maxFrameBytes": 4096,
      "pieces": [
        "{\"type\":\"req\",\"id\":\"r\",\"method\":\"a.b\",\"params\":\"\"}\r\n"
      ],
      "expected": [
        {
          "type": "req",
          "id": "r",
          "method": "a.b",
          "params": ""
        }
      ],
      "note": "The line is exactly maxFrameBytes; the \\r belongs to the terminator and does not count. The replay of every accept case at every split offset is the point: cutting between the \\r and the \\n leaves a buffer one byte over the limit that a decoder must not refuse for it."
    },
    {
      "name": "y_blank_lines_ignored",
      "verdict": "accept",
      "pieces": [
        "\n\r\n   \n{\"type\":\"ping\"}\n\n"
      ],
      "expected": [
        {
          "type": "ping"
        }
      ]
    },
    {
      "name": "y_split_across_pushes",
      "verdict": "accept",
      "pieces": [
        "{\"type\":\"re",
        "q\",\"id\":\"r\",\"method\":\"a.b\",\"pa",
        "rams\":{}}\n"
      ],
      "expected": [
        {
          "type": "req",
          "id": "r",
          "method": "a.b",
          "params": {}
        }
      ]
    },
    {
      "name": "y_split_inside_multibyte",
      "verdict": "accept",
      "pieces": [
        "{\"type\":\"req\",\"id\":\"é",
        "\",\"method\":\"a.b\",\"params\":\"🥭\"}\n"
      ],
      "expected": [
        {
          "type": "req",
          "id": "é",
          "method": "a.b",
          "params": "🥭"
        }
      ],
      "note": "Pieces are text and cannot end inside a character. Byte-oriented decoders must also join the pieces, encode to UTF-8 and split at byte 21, between the two bytes of é (bytes 20 and 21), or at every byte offset."
    },
    {
      "name": "y_final_record_without_terminator",
      "verdict": "accept",
      "pieces": [
        "{\"type\":\"ping\"}"
      ],
      "finish": true,
      "expected": [
        {
          "type": "ping"
        }
      ]
    },
    {
      "name": "y_finish_with_empty_buffer",
      "verdict": "accept",
      "pieces": [
        "{\"type\":\"ping\"}\n"
      ],
      "finish": true,
      "expected": [
        {
          "type": "ping"
        }
      ]
    },
    {
      "name": "n_oversized_line",
      "verdict": "reject",
      "maxFrameBytes": 4096,
      "pieces": [
        "{\"type\":\"req\",\"id\":\"r\",\"method\":\"a.b\",\"params\":\"\"}\n"
      ],
      "reason": "too-large"
    },
    {
      "name": "n_oversized_partial_line",
      "verdict": "reject",
      "maxFrameBytes": 4096,
      "pieces": [
        "{\"type\":\"req\",\"id\":\"r\",\"method\":\"a.b\",\"params\":\""
      ],
      "reason": "too-large",
      "note": "Refused before the terminator arrives."
    },
    {
      "name": "n_oversized_blank_line",
      "verdict": "reject",
      "maxFrameBytes": 4096,
      "pieces": [
        "                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 \n"
      ],
      "reason": "too-large",
      "note": "A whitespace-only line is normally ignored once complete, but must still refuse when it exceeds the limit, the same as the identical bytes would while still partial (see n_oversized_partial_line)."
    },
    {
      "name": "n_invalid_record_mid_stream",
      "verdict": "reject",
      "pieces": [
        "{\"type\":\"ping\"}\n{\"type\":\"nope\"}\n{\"type\":\"pong\"}\n"
      ],
      "expected": [
        {
          "type": "ping"
        }
      ],
      "reason": "schema",
      "note": "Frames before the refused record are delivered; the refusal ends the stream."
    }
  ]
}
