{
  "name": "@mangostudio/shared",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "check": "biome check src tests && eslint src tests --max-warnings 0 --cache --cache-location ../../node_modules/.cache/eslint/.eslintcache.shared && tsc --noEmit",
    "check:quick": "biome check src tests && eslint src tests --max-warnings 0 --cache --cache-location ../../node_modules/.cache/eslint/.eslintcache.shared",
    "fix": "biome check --write src tests && eslint src tests --fix --max-warnings 0 --cache --cache-location ../../node_modules/.cache/eslint/.eslintcache.shared",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:coverage": "vitest run --coverage"
  },
  "exports": {
    ".": "./src/index.ts",
    "./chat": "./src/chat/index.ts",
    "./generation": "./src/generation/index.ts",
    "./app-settings": "./src/app-settings/index.ts",
    "./connectors": "./src/connectors/index.ts",
    "./provider-settings": "./src/provider-settings/index.ts",
    "./tool-settings": "./src/tool-settings/index.ts",
    "./catalog": "./src/catalog/index.ts",
    "./observability": "./src/observability/index.ts",
    "./agents": "./src/agents/index.ts",
    "./streaming": "./src/streaming/index.ts",
    "./auth": "./src/auth/index.ts",
    "./errors": "./src/errors/index.ts",
    "./types": "./src/types/index.ts",
    "./contracts": "./src/contracts/index.ts",
    "./test-utils": "./src/test-utils/index.ts",
    "./i18n": "./src/i18n/index.ts",
    "./utils/model-detection": "./src/utils/model-detection.ts",
    "./prompt-rules": "./src/prompt-rules/index.ts"
  },
  "devDependencies": {
    "typescript": "~6.0.3"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.49"
  }
}
