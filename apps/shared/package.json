{
  "name": "@mangostudio/shared",
  "version": "0.1.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "check": "bun run check:quick && bun run typecheck",
    "check:quick": "biome check src tests",
    "typecheck": "tsc --noEmit",
    "circular": "madge --circular --extensions ts,tsx .",
    "fix": "biome check --write src tests",
    "test": "bun run test:unit",
    "test:unit": "bun test --timeout 15000 tests/unit",
    "test:coverage": "bun test --timings=../../.mango/artifacts/timings/shared.json --update-timings --coverage --timeout 15000 --reporter=junit --reporter-outfile=../../.mango/artifacts/junit/shared.xml $MANGOSTUDIO_BUN_TEST_ARGS"
  },
  "exports": {
    ".": "./src/index.ts",
    "./activity": "./src/activity/index.ts",
    "./chat": "./src/chat/index.ts",
    "./generation": "./src/generation/index.ts",
    "./app-settings": "./src/app-settings/index.ts",
    "./connectors": "./src/connectors/index.ts",
    "./provider-settings": "./src/provider-settings/index.ts",
    "./tool-settings": "./src/tool-settings/index.ts",
    "./catalog": "./src/catalog/index.ts",
    "./observability": "./src/observability/index.ts",
    "./agents": "./src/agents/index.ts",
    "./capabilities": "./src/capabilities/index.ts",
    "./streaming": "./src/streaming/index.ts",
    "./auth": "./src/auth/index.ts",
    "./errors": "./src/errors/index.ts",
    "./types": "./src/types/index.ts",
    "./contracts": "./src/contracts/index.ts",
    "./test-utils": "./src/test-utils/index.ts",
    "./i18n": "./src/i18n/index.ts",
    "./markdown": "./src/markdown/index.ts",
    "./mcp": "./src/mcp/index.ts",
    "./skills": "./src/skills/index.ts",
    "./todos": "./src/todos/index.ts",
    "./tool-executions": "./src/tool-executions/index.ts",
    "./turn-recovery": "./src/turn-recovery/index.ts",
    "./utils/model-detection": "./src/utils/model-detection.ts",
    "./utils/dist-files": "./src/utils/dist-files.ts",
    "./runtime-env": "./src/runtime-env/index.ts",
    "./runtime-env/env-file": "./src/runtime-env/env-file.ts",
    "./prompt-rules": "./src/prompt-rules/index.ts",
    "./questions": "./src/questions/index.ts",
    "./workspaces": "./src/workspaces/index.ts",
    "./git": "./src/git/index.ts",
    "./github": "./src/github/index.ts",
    "./file-checkpoints": "./src/file-checkpoints/index.ts",
    "./library": "./src/library/index.ts",
    "./library/host": "./src/library/host.ts",
    "./environments": "./src/environments/index.ts",
    "./external-agents": "./src/external-agents/index.ts",
    "./environments/detection": "./src/environments/detection/index.ts",
    "./profiles": "./src/profiles/index.ts",
    "./api-keys": "./src/api-keys/index.ts",
    "./realtime": "./src/realtime/index.ts",
    "./tool-identity": "./src/tool-identity/index.ts",
    "./runtime-protocol": "./src/runtime-protocol/index.ts",
    "./runtime-home": "./src/runtime-home/index.ts",
    "./machine": "./src/machine/index.ts",
    "./terminal": "./src/terminal/index.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@faker-js/faker": "^10.5.0",
    "typebox": "1.3.13"
  }
}
