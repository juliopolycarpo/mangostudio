{
  "name": "@mangostudio/frontend",
  "version": "0.1.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "bun ./build.ts",
    "routes": "bun ./scripts/routes.ts",
    "check": "bun run check:quick && bun run check:cycles && bun run typecheck",
    "check:quick": "biome check .",
    "check:cycles": "bun ../../scripts/check-import-cycles.ts .",
    "typecheck": "tsc --noEmit",
    "fix": "biome check --write .",
    "test": "bun run test:unit && bun run test:integration",
    "test:unit": "bun test --tsconfig-override=./tsconfig.test.json --parallel=4 --isolate --timeout 15000 tests/unit",
    "test:integration": "bun test --tsconfig-override=./tsconfig.test.json --parallel=4 --isolate --timeout 15000 tests/integration",
    "test:coverage": "bun test --tsconfig-override=./tsconfig.test.json --isolate --parallel=4 --timeout 15000 tests --coverage --timings=../../.mango/artifacts/timings/frontend.json --update-timings --reporter=junit --reporter-outfile=../../.mango/artifacts/junit/frontend.xml && bun ../../scripts/qa-gate/enforce-coverage-thresholds.ts frontend"
  },
  "dependencies": {
    "@elysia/eden": "2.0.0-beta.6",
    "@mangostudio/shared": "workspace:*",
    "@shikijs/core": "4.5.0",
    "@shikijs/engine-javascript": "4.5.0",
    "@shikijs/langs": "4.5.0",
    "@shikijs/themes": "4.5.0",
    "@tanstack/react-query": "^5.104.3",
    "@tanstack/react-router": "1.170.45",
    "@tanstack/react-virtual": "^3.14.20",
    "@xterm/addon-clipboard": "0.2.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "better-auth": "^1.7.10",
    "clsx": "^2.1.1",
    "lucide-react": "^1.58.0",
    "marked": "^18.1.1",
    "motion": "^14.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.3",
    "@mangostudio/api": "workspace:*",
    "@tanstack/router-generator": "1.167.45",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "4.3.3",
    "@tailwindcss/node": "4.3.3",
    "@tailwindcss/oxide": "4.3.3",
    "typescript": "7.0.2"
  }
}
