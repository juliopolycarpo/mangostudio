{
  "name": "@mangostudio/frontend",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "bun run check:quick && bun run typecheck",
    "check:quick": "biome check src tests",
    "typecheck": "tsgo --noEmit",
    "fix": "biome check --write src tests",
    "test": "bun run test:unit && bun run test:integration",
    "test:unit": "bun run test:unit:bun && bun run test:unit:vitest",
    "test:unit:bun": "bun test tests/unit/lib/utils.test.ts tests/unit/utils/model-utils.test.ts",
    "test:unit:vitest": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:coverage": "vitest run --coverage && bun test --coverage tests/unit/lib/utils.test.ts tests/unit/utils/model-utils.test.ts",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@elysiajs/eden": "^1.4.8",
    "@mangostudio/shared": "workspace:*",
    "@tanstack/react-query": "^5.100.9",
    "@tanstack/react-router": "1.169.2",
    "@tanstack/react-virtual": "^3.13.24",
    "better-auth": "^1.6.11",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^1.14.0",
    "marked": "^18.0.3",
    "motion": "^12.23.24",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "shiki": "^4.0.2",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@mangostudio/api": "workspace:*",
    "@tailwindcss/vite": "^4.2.4",
    "@tanstack/router-devtools": "1.167.0",
    "@tanstack/router-plugin": "1.167.35",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.7",
    "@vitest/ui": "^4.1.7",
    "jsdom": "^29.1.1",
    "smol-toml": "^1.6.1",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.13",
    "vitest": "^4.1.7"
  }
}
