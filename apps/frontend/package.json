{
  "name": "@mangostudio/frontend",
  "version": "0.1.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "bun ./build.ts",
    "routes": "tsr generate",
    "check": "bun run check:quick && bun run typecheck",
    "check:quick": "biome check src tests",
    "typecheck": "tsc --noEmit",
    "circular": "madge --circular --extensions ts,tsx .",
    "fix": "biome check --write src tests",
    "test": "bun run test:unit && bun run test:integration",
    "test:unit": "bun test --tsconfig-override=./tsconfig.test.json --parallel=4 --isolate --timeout 15000 tests/unit",
    "test:integration": "bun test --tsconfig-override=./tsconfig.test.json --parallel=4 --isolate --timeout 15000 tests/integration",
    "test:coverage": "bun test --tsconfig-override=./tsconfig.test.json --isolate --parallel=4 --timeout 15000 tests --coverage --timings=../../.mango/artifacts/timings/frontend.json --update-timings --reporter=junit --reporter-outfile=../../.mango/artifacts/junit/frontend.xml && bun ../../scripts/qa-gate/enforce-coverage-thresholds.ts frontend"
  },
  "dependencies": {
    "@elysia/eden": "2.0.0-beta.6",
    "@mangostudio/shared": "workspace:*",
    "@shikijs/core": "4.5.0",
    "@shikijs/engine-javascript": "4.5.0",
    "@shikijs/langs": "4.5.0",
    "@shikijs/themes": "4.5.0",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-virtual": "^3.14.13",
    "@xterm/addon-clipboard": "0.2.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "better-auth": "^1.7.7",
    "clsx": "^2.1.1",
    "lucide-react": "^1.51.0",
    "marked": "^18.0.14",
    "motion": "^13.5.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.14.5",
    "@mangostudio/api": "workspace:*",
    "@tanstack/router-cli": "1.167.40",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "bun-plugin-tailwind": "^0.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2"
  }
}
