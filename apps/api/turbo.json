{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "outputs": ["dist/**"]
    },
    "test:unit": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/with-test-home.ts",
        "$TURBO_ROOT$/scripts/lib/test-home.ts",
        "$TURBO_ROOT$/scripts/lib/temp-home.ts",
        "$TURBO_ROOT$/scripts/run-test-workers.ts",
        "$TURBO_ROOT$/scripts/lib/test-workers.ts",
        "$TURBO_ROOT$/scripts/lib/test-worker-process.ts",
        "$TURBO_ROOT$/scripts/lib/junit-report.ts",
        "$TURBO_ROOT$/scripts/lib/test-lanes.ts",
        "$TURBO_ROOT$/scripts/lib/config.ts",
        "$TURBO_ROOT$/scripts/lib/log.ts"
      ],
      "passThroughEnv": [
        "CARGO_HOME",
        "RUSTUP_HOME",
        "BUN_INSTALL",
        "BUN_INSTALL_CACHE_DIR",
        "MANGO_TEST_WORKERS"
      ]
    },
    "test:integration": {
      "passThroughEnv": ["CARGO_HOME", "RUSTUP_HOME", "BUN_INSTALL", "BUN_INSTALL_CACHE_DIR"]
    },
    "test:coverage": {
      "passThroughEnv": ["CARGO_HOME", "RUSTUP_HOME", "BUN_INSTALL", "BUN_INSTALL_CACHE_DIR"]
    }
  }
}
