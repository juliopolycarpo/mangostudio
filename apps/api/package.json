{
  "name": "@mangostudio/api",
  "version": "0.1.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/app.ts"
  },
  "scripts": {
    "dev": "bun run --watch src/index.ts serve",
    "start": "bun run src/index.ts serve",
    "build": "bun build src/index.ts --target=bun --outdir=dist",
    "check": "bun run check:quick && bun run typecheck",
    "check:quick": "biome check src tests",
    "typecheck": "tsc --noEmit",
    "circular": "madge --circular --extensions ts,tsx .",
    "fix": "biome check --write src tests",
    "migrate": "bun run src/db/migrate.ts",
    "test": "bun run test:unit && bun run test:integration",
    "test:unit": "MANGOSTUDIO_DIAGNOSTIC_LOGS=0 bun test --parallel=1 tests/unit",
    "test:integration": "MANGOSTUDIO_DIAGNOSTIC_LOGS=0 bun test tests/integration",
    "test:coverage": "MANGOSTUDIO_DIAGNOSTIC_LOGS=0 bun test --coverage --parallel=1 tests/unit tests/integration"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "^3.0.11",
    "@anthropic-ai/sdk": "^0.95.1",
    "@cursor/sdk": "^1.0.22",
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/openapi": "^1.4.15",
    "@elysiajs/static": "^1.4.10",
    "@google/genai": "^1.52.0",
    "@mangostudio/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ai": "^7.0.19",
    "better-auth": "^1.6.11",
    "elysia": "^1.4.29",
    "file-type": "^22.0.1",
    "kysely": "^0.29.3",
    "kysely-bun-sqlite": "^0.4.0",
    "openai": "^6.48.0",
    "smol-toml": "^1.7.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.4.0",
    "@sinclair/typebox": "^0.34.0",
    "@types/bun": "^1.3.14",
    "typescript": "7.0.2"
  }
}
