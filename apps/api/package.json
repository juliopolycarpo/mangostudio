{
  "name": "@mangostudio/api",
  "version": "0.1.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/app.ts",
    "./internal/*": "./src/*.ts",
    "./test-support/chatgpt/fake-server": "./tests/support/chatgpt/fake-server.ts"
  },
  "scripts": {
    "dev": "bun run --watch src/dev.ts serve",
    "start": "bun run src/index.ts serve",
    "build": "bun build src/index.ts --target=bun --outdir=dist",
    "check": "bun run check:quick && bun run check:cycles && bun run typecheck",
    "check:quick": "bun --cwd ../.. lint apps/api && bun --cwd ../.. fmt --check apps/api",
    "check:cycles": "bun ../../scripts/check-import-cycles.ts .",
    "typecheck": "tsc --noEmit",
    "fix": "bun --cwd ../.. lint --fix apps/api && bun --cwd ../.. fmt apps/api",
    "migrate": "bun run src/db/migrate.ts",
    "test": "bun run test:unit && bun run test:integration",
    "test:unit": "MANGOSTUDIO_DIAGNOSTIC_LOGS=0 bun ../../scripts/run-test-workers.ts --lane=api-unit -- bun test --timeout 15000 --parallel=1 tests/unit",
    "test:integration": "MANGOSTUDIO_DIAGNOSTIC_LOGS=0 bun ../../scripts/run-test-workers.ts --lane=api-integration -- bun test --timeout 15000 tests/integration",
    "test:coverage": "bun ../../scripts/ci/run-workspace-coverage.ts --workspace=api",
    "test:coverage:unit": "MANGOSTUDIO_DIAGNOSTIC_LOGS=0 bun ../../scripts/with-test-home.ts bun test --timings=../../.mango/artifacts/timings/api-unit.json --update-timings --coverage --coverage-dir=../../.mango/artifacts/coverage/api-unit --timeout 15000 --parallel=4 --reporter=junit --reporter-outfile=../../.mango/artifacts/junit/api-unit.xml $MANGOSTUDIO_BUN_TEST_ARGS tests/unit",
    "test:coverage:integration": "MANGOSTUDIO_DIAGNOSTIC_LOGS=0 bun ../../scripts/with-test-home.ts bun test --coverage --coverage-dir=../../.mango/artifacts/coverage/api-integration --timeout 15000 --reporter=junit --reporter-outfile=../../.mango/artifacts/junit/api-integration.xml $MANGOSTUDIO_BUN_TEST_ARGS tests/integration"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
    "@better-auth/api-key": "1.7.12",
    "@elysia/cors": "2.0.0-rc.0",
    "@elysia/openapi": "2.0.0-rc.0",
    "@google/genai": "^2.31.0",
    "@mangostudio/protocol": "workspace:*",
    "@mangostudio/shared": "workspace:*",
    "better-auth": "^1.7.12",
    "elysia": "2.0.0-rc.0",
    "exact-mirror": "1.2.6",
    "file-type": "^22.2.0",
    "kysely": "^0.29.7",
    "openai": "^7.43.0",
    "typebox": "1.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/bun": "^1.4.4",
    "typescript": "7.0.2"
  }
}
