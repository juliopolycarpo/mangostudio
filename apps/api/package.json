{
  "name": "@mangostudio/api",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/app.ts"
  },
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --target=bun --outdir=dist",
    "check": "eslint src tests --max-warnings 0 --cache --cache-location ../../node_modules/.cache/eslint/.eslintcache.api && prettier --ignore-path ../../.prettierignore --check 'src/**/*.{ts,json}' 'tests/**/*.ts' --cache --cache-location ../../node_modules/.cache/prettier/.prettiercache.api && tsc --noEmit",
    "check:quick": "eslint src tests --max-warnings 0 --cache --cache-location ../../node_modules/.cache/eslint/.eslintcache.api && prettier --ignore-path ../../.prettierignore --check 'src/**/*.{ts,json}' 'tests/**/*.ts' --cache --cache-location ../../node_modules/.cache/prettier/.prettiercache.api",
    "fix": "eslint src tests --fix --max-warnings 0 --cache --cache-location ../../node_modules/.cache/eslint/.eslintcache.api && prettier --ignore-path ../../.prettierignore --write 'src/**/*.{ts,json}' 'tests/**/*.ts' --cache --cache-location ../../node_modules/.cache/prettier/.prettiercache.api",
    "migrate": "bun run src/db/migrate.ts",
    "test": "bun run test:unit && bun run test:integration",
    "test:unit": "bun test tests/unit",
    "test:integration": "bun test tests/integration",
    "test:coverage": "bun test --coverage tests/unit tests/integration"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "^2.0.32",
    "@ai-sdk/openai-compatible": "^2.0.45",
    "@anthropic-ai/sdk": "^0.92.0",
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/openapi": "^1.4.15",
    "@elysiajs/static": "^1.4.10",
    "@google/genai": "^1.51.0",
    "@mangostudio/shared": "workspace:*",
    "ai": "^6.0.174",
    "better-auth": "^1.6.9",
    "elysia": "^1.4.28",
    "file-type": "^22.0.1",
    "kysely": "^0.28.16",
    "kysely-bun-sqlite": "^0.4.0",
    "openai": "^6.35.0",
    "smol-toml": "^1.6.1"
  },
  "devDependencies": {
    "@sinclair/typebox": "^0.34.0",
    "@types/bun": "^1.3.13",
    "typescript": "~6.0.3"
  }
}
