{
  "name": "@mangostudio/api",
  "version": "0.1.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/app.ts",
    "./internal/*": "./src/*.ts"
  },
  "scripts": {
    "dev": "bun run --watch src/index.ts serve",
    "start": "bun run src/index.ts serve",
    "build": "bun build src/index.ts --target=bun --outdir=dist",
    "check": "bun run check:quick && bun run typecheck",
    "check:quick": "biome check src tests",
    "typecheck": "tsc --noEmit",
    "circular": "madge --circular --extensions ts,tsx .",
    "fix": "biome check --write src tests",
    "migrate": "bun run src/db/migrate.ts",
    "test": "bun run test:unit && bun run test:integration",
    "test:unit": "MANGOSTUDIO_DIAGNOSTIC_LOGS=0 bun test --timeout 15000 --parallel=1 tests/unit",
    "test:integration": "MANGOSTUDIO_DIAGNOSTIC_LOGS=0 bun test --timeout 15000 tests/integration",
    "test:coverage": "MANGOSTUDIO_DIAGNOSTIC_LOGS=0 bun test --coverage --timeout 15000 --parallel=1 tests/unit tests/integration"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "^3.0.24",
    "@anthropic-ai/sdk": "^0.115.0",
    "@better-auth/api-key": "1.6.26",
    "@elysia/cors": "2.0.0-beta.1",
    "@elysia/openapi": "2.0.0-beta.1",
    "@elysia/static": "2.0.0-beta.2",
    "@google/genai": "^1.52.0",
    "@mangostudio/runtime": "workspace:*",
    "@mangostudio/shared": "workspace:*",
    "ai": "^7.0.55",
    "better-auth": "^1.6.26",
    "elysia": "2.0.0-beta.4",
    "exact-mirror": "1.2.4",
    "file-type": "^22.0.1",
    "kysely": "^0.29.4",
    "kysely-bun-sqlite": "^0.4.0",
    "openai": "^6.48.0",
    "smol-toml": "^1.7.0",
    "typebox": "1.3.13"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.5.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/bun": "^1.3.14",
    "typescript": "7.0.2"
  }
}
