{
  "name": "@mangostudio/runtime",
  "version": "0.1.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "bun build src/index.ts --target=bun --outdir=dist",
    "check": "bun run check:quick && bun run typecheck",
    "check:quick": "biome check src tests",
    "typecheck": "tsc --noEmit",
    "circular": "madge --circular --extensions ts,tsx .",
    "fix": "biome check --write src tests",
    "test": "bun run test:unit",
    "test:unit": "bun test tests/unit",
    "test:coverage": "bun test --coverage"
  },
  "dependencies": {
    "@mangostudio/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "smol-toml": "^1.8.0",
    "typebox": "1.3.13"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "7.0.2"
  }
}
