# MangoStudio Configuration
# Copy this file to ~/.mango/config.toml.
#
# Resolution hierarchy (highest priority wins):
# 1. process.env       — shell environment
# 2. .env              — stored next to this config.toml
# 3. config.toml       — ~/.mango/config.toml
# 4. Built-in defaults — hardcoded in the application

[server]
host = "localhost"
port = 3001

[frontend]
host = "localhost"
port = 5173

[database]
# Empty = auto-detect:
#   ~/.mango/database.sqlite
path = ""

[uploads]
# Empty = auto-detect: ~/.mango/uploads
dir = ""

[images]
# Empty = auto-detect: ~/.mango/images in all runtimes
dir = ""

[agents]
# Empty = auto-detect: ~/.mango/agents in all runtimes
dir = ""

[auth]
# Minimum 32 characters. If empty, `mangostudio serve` can generate and store one.
secret = "your-secret-key-here-min-32-chars"
# Empty = derived from server host:port
url = ""

[security]
# Trust proxy headers (X-Forwarded-For / X-Real-IP / CF-Connecting-IP) when
# resolving the client IP for rate limiting. Enable ONLY behind a reverse proxy
# that overwrites these headers (nginx, a load balancer, Docker behind a proxy);
# otherwise clients can spoof their IP. Default: false.
# trustProxy = false

# Gemini API key connectors.
# Keys defined here appear automatically in the Settings UI.
# You can enable/disable specific models per connector in the UI.
[gemini_api_keys]
# personal = "AIzaSy..."
# work = "AIzaSy..."

# OpenAI-compatible API key connectors.
# Works with OpenRouter and other compatible APIs.
# Base URLs for non-OpenAI services are configured in the Settings UI.
[openai_compatible_api_keys]
# openai = "sk-..."
# openrouter = "sk-or-..."

# DeepSeek API key connectors.
# Uses https://api.deepseek.com by default; advanced users can override
# the base URL from the Settings UI.
[deepseek_api_keys]
# personal = "sk-..."

# Anthropic API key connectors.
[anthropic_api_keys]
# default = "sk-ant-..."

# Cursor API key connectors.
[cursor_api_keys]
# default = "cursor_..."

# Optional workspace directory for Cursor SDK local agents.
# Empty = current working directory when MangoStudio starts.
[cursor]
# workspace_dir = "/path/to/your/project"
