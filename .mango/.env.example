# MangoStudio Environment Overrides
# Copy this file to ~/.mango/.env next to ~/.mango/config.toml.
# This file takes highest priority over config.toml for matching keys.
#
# Only the keys listed below are recognized as overrides.
# Secrets (API keys, auth secret) are best placed here instead of config.toml.

# BETTER_AUTH_SECRET=your-secret-key-here-min-32-chars
# BETTER_AUTH_URL=http://localhost:3001

# API_HOST=localhost
# API_PORT=3001
# Deprecated and ignored — the API serves the frontend on API_PORT.
# FRONTEND_PORT=5173

# Extra browser origins allowed to call this API, for a split deployment where
# the frontend bundle is served from somewhere else. Comma-separated, added to
# the server's own origins. Each entry must be a bare scheme://host[:port]:
# a path, a trailing slash, or an explicit default port fails at startup.
# ALLOWED_ORIGINS=https://studio.example.com,https://staging.example.com

# DATABASE_PATH=
# UPLOADS_DIR=
# IMAGES_DIR=
# AGENTS_DIR=
# SKILLS_DIR=
# CHECKPOINTS_DIR=

# Trust proxy headers (X-Forwarded-For / X-Real-IP / CF-Connecting-IP) when
# resolving the client IP for rate limiting. Enable ONLY behind a reverse proxy
# that overwrites these headers (nginx, a load balancer, Docker behind a proxy);
# otherwise clients can spoof their IP. Accepts 1/true/yes/on.
# TRUST_PROXY=false

# Gemini API keys (per-connector or global fallback)
# GEMINI_API_KEY=AIzaSy...
# GEMINI_API_KEY_PERSONAL=AIzaSy...

# DeepSeek API keys (per-connector or global fallback)
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_API_KEY_PERSONAL=sk-...

# Cursor API keys (per-connector or global fallback)
# CURSOR_API_KEY=cursor_...
# CURSOR_API_KEY_DEFAULT=cursor_...

# Optional workspace directory for Cursor SDK local agents
# CURSOR_WORKSPACE_DIR=/path/to/your/project

# Optional override for the Cursor SDK sidecar script (smoke tests / advanced debugging)
# MANGO_CURSOR_SIDECAR_SCRIPT=/absolute/path/to/run-agent.mjs

# ChatGPT OAuth/backend endpoint overrides (smoke tests / advanced debugging)
# MANGO_CHATGPT_AUTH_BASE_URL=https://auth.openai.com
# MANGO_CHATGPT_BASE_URL=https://chatgpt.com/backend-api/codex

# Unsafe plaintext secret store for automated binary smoke tests. When set, it
# replaces native Bun.secrets storage. Leave empty in normal use.
# MANGO_SECRET_STORE_UNSAFE_FILE_FALLBACK_DIR=
