{
  "$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/node_modules",
      "!apps/*/dist",
      "!apps/*/coverage",
      "!.mango/artifacts",
      "!.mango/out",
      "!apps/frontend/src/routeTree.gen.ts",
      "!apps/runtime/src/services/external-agents/codex/protocol",
      "!apps/runtime/src/services/external-agents/*/contract"
    ]
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 100,
    "attributePosition": "auto",
    "bracketSameLine": false,
    "bracketSpacing": true,
    "expand": "auto",
    "useEditorconfig": true,
    "includes": ["**", "!**/*.{md,mdx}"]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "noLabelWithoutControl": {
          "level": "error",
          "options": { "inputComponents": ["Checkbox", "Input", "Select", "Toggle"] }
        }
      },
      "nursery": { "useAwaitThenable": "off" },
      "performance": { "noDelete": "warn" },
      "style": {
        "noNestedTernary": "off",
        "useBlockStatements": "off"
      },
      "suspicious": {}
    }
  },
  "javascript": {
    "formatter": {
      "jsxQuoteStyle": "double",
      "quoteProperties": "asNeeded",
      "trailingCommas": "es5",
      "semicolons": "always",
      "arrowParentheses": "always",
      "bracketSameLine": false,
      "quoteStyle": "single",
      "attributePosition": "auto",
      "bracketSpacing": true
    }
  },
  "css": { "parser": { "tailwindDirectives": true } },
  "html": { "formatter": { "indentScriptAndStyle": false, "selfCloseVoidElements": "always" } },
  "overrides": [
    {
      "includes": ["**/*.{ts,tsx}"],
      "javascript": { "globals": [] },
      "linter": {
        "rules": {
          "complexity": {
            "noArguments": "error",
            "noBannedTypes": "error",
            "noUselessThisAlias": "error",
            "noUselessTypeConstraint": "error",
            "useLiteralKeys": "error",
            "useOptionalChain": "error"
          },
          "correctness": {
            "noConstAssign": "off",
            "noGlobalObjectCalls": "off",
            "noInvalidBuiltinInstantiation": "off",
            "noInvalidConstructorSuper": "off",
            "noSetterReturn": "off",
            "noUndeclaredVariables": "off",
            "noUnreachable": "off",
            "noUnreachableSuper": "off",
            "noUnusedVariables": "error"
          },
          "nursery": {
            "noBaseToString": "error",
            "noFloatingPromises": "error",
            "noImpliedEval": "error",
            "noMisusedPromises": "error",
            "noUnsafePlusOperands": "error",
            "useExplicitReturnType": "off",
            "useExplicitType": "off"
          },
          "style": {
            "noCommonJs": "error",
            "noInferrableTypes": "error",
            "noNamespace": "error",
            "noNonNullAssertion": "error",
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@mangostudio/shared/i18n": {
                    "allowImportNames": ["Locale", "Messages", "defaultLocale"],
                    "message": "Locale dictionaries are i18n plumbing. Render layers must localize via useI18n(); data layers must throw ApiError for failed requests."
                  }
                }
              }
            },
            "noUselessElse": "error",
            "useArrayLiterals": "error",
            "useAsConstAssertion": "error",
            "useConst": "error",
            "useExponentiationOperator": "error",
            "useImportType": "error",
            "useNodejsImportProtocol": "error",
            "useTemplate": "error",
            "useThrowOnlyError": "error",
            "useSpreadOverApply": "error"
          },
          "suspicious": {
            "noClassAssign": "off",
            "noConsole": { "level": "warn", "options": { "allow": ["warn", "error"] } },
            "noDuplicateClassMembers": "off",
            "noDuplicateObjectKeys": "off",
            "noDuplicateParameters": "off",
            "noEmptyBlockStatements": "error",
            "noExplicitAny": "error",
            "noExtraNonNullAssertion": "error",
            "noFunctionAssign": "off",
            "noImportAssign": "off",
            "noMisleadingInstantiator": "error",
            "noNonNullAssertedOptionalChain": "error",
            "noRedeclare": "off",
            "noTsIgnore": "error",
            "noUnsafeDeclarationMerging": "error",
            "noUnsafeNegation": "off",
            "noUnusedExpressions": "off",
            "noVar": "error",
            "noWith": "off",
            "useAwait": "error",
            "useGetterReturn": "off",
            "useNamespaceKeyword": "error",
            "noDuplicateEnumValues": "error",
            "noForIn": "error"
          }
        }
      }
    },
    {
      "includes": ["apps/api/src/**/*.ts"],
      "linter": { "rules": { "nursery": {}, "suspicious": { "noUnnecessaryConditions": "off" } } }
    },
    {
      "includes": ["scripts/**/*.ts"],
      "linter": { "rules": { "suspicious": { "noConsole": "off" } } }
    },
    {
      "includes": ["apps/frontend/src/hooks/use-i18n.tsx", "apps/frontend/tests/**/*.{ts,tsx}"],
      "linter": { "rules": { "style": { "noRestrictedImports": "off" } } }
    },
    {
      "includes": [
        "apps/api/src/services/**/*.ts",
        "apps/api/src/utils/**/*.ts",
        "apps/api/src/lib/**/*.ts",
        "apps/api/src/db/**/*.ts",
        "apps/shared/src/**/*.ts"
      ],
      "linter": { "rules": { "nursery": { "useExplicitType": "off" } } }
    },
    {
      "includes": ["apps/frontend/**/*.{ts,tsx}"],
      "linter": {
        "rules": {
          "correctness": {
            "noChildrenProp": "warn",
            "noNestedComponentDefinitions": "error",
            "noRenderReturnValue": "error",
            "noVoidElementsWithChildren": "error",
            "useExhaustiveDependencies": {
              "level": "error",
              "options": { "reportUnnecessaryDependencies": false }
            },
            "useHookAtTopLevel": "error",
            "useJsxKeyInIterable": "error"
          },
          "nursery": {
            "noComponentHookFactories": "error",
            "noJsxNamespace": "error",
            "useReactAsyncServerFunction": "error"
          },
          "security": {
            "noDangerouslySetInnerHtml": "warn",
            "noDangerouslySetInnerHtmlWithChildren": "error",
            "noScriptUrl": "warn"
          },
          "suspicious": {
            "noArrayIndexKey": "warn",
            "noCommentText": "error",
            "noReactForwardRef": "warn",
            "noSuspiciousSemicolonInJsx": "error"
          }
        }
      }
    }
  ],
  "assist": { "enabled": true, "actions": { "source": { "organizeImports": "on" } } }
}
