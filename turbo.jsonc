{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  // turbo 2.11.6 rewrites the root AGENTS.md with a managed guidance block
  // whenever it detects an AI coding agent. AGENTS.md is hand-maintained here
  // and an agent session must not leave it modified, so the block stays off.
  "agentGuidance": false,
  // Bun records a patch's path in the lockfile, not its bytes. A patch-only edit
  // changes installed dependency code and must invalidate cached tasks too.
  "globalDependencies": ["patches/**"],
  // Env vars read by the root build/release/CI scripts (scripts/build.ts,
  // scripts/test-build.ts, scripts/release/*, scripts/lib/release-version.ts,
  // scripts/ci/*), which run via `bun run` outside turbo tasks. Declared as pass-through so
  // biome's noUndeclaredEnvVars accepts them without affecting task cache keys.
  "globalPassThroughEnv": [
    "ACTIONS_ID_TOKEN_REQUEST_TOKEN",
    "ACTIONS_ID_TOKEN_REQUEST_URL",
    "ALLOWED_SKIPS",
    "API_PORT",
    // Where the runtime build scripts find cargo's output when it is not `target/`.
    "CARGO_TARGET_DIR",
    "DISTRIBUTION_CHANNEL",
    "DISTRIBUTION_MANIFEST_PATH",
    "DRY_RUN",
    "GITHUB_ACTIONS",
    "GITHUB_OUTPUT",
    // Names the repository whose Actions cache usage the gate job reports.
    "GITHUB_REPOSITORY",
    "GITHUB_SHA",
    // The gate's cache-usage report renders its table here.
    "GITHUB_STEP_SUMMARY",
    // Read only by the gate's cache-usage report, which needs `actions: read`.
    "GITHUB_TOKEN",
    "MANGO_ARCHIVE_CONCURRENCY",
    "MANGO_API_BASE",
    "MANGO_API_KEY",
    "NEEDS",
    "NODE_AUTH_TOKEN",
    "NPM_PUBLISH_ALLOW_LEGACY_TOKEN",
    "ONLY_PLATFORM",
    "PLATFORM",
    // The PowerShell installer probes the actual host architecture in strict test tasks.
    "PROCESSOR_ARCHITECTURE",
    // Where a Windows host keeps PowerShell's module analysis cache when it is not under
    // LOCALAPPDATA (GitHub's images). Without it every Windows PowerShell child in a strict
    // task re-analyses each module: 12-23 s per command instead of under 3 s.
    "PSModuleAnalysisCachePath",
    "QA_FRONTEND_DIST",
    "RUNNER_OS",
    // Prebuilt cargo runtimes `scripts/build.ts --binary` stages beside each hub.
    "RUNTIME_DIR",
    "SKIP_BUILD",
    "SOURCE_SHA",
    "VERSION"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "interruptible": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "check:quick": {
      "inputs": ["$TURBO_ROOT$/biome.json", "$TURBO_DEFAULT$"]
    },
    // Script-less: no workspace defines a `transit` script, so it runs nothing
    // and orders nothing. It exists for its hash. Turbo folds the hash of each
    // `dependsOn` task into the dependent's own, so a task that depends on
    // `transit` is rebuilt whenever a workspace it imports changes, yet starts
    // at once. A task that reads its dependencies' sources and has nothing for
    // them to wait on opts in with `"dependsOn": ["transit"]` (`typecheck` and
    // `test:unit` do). It must declare no `inputs`: the default set is what
    // carries an upstream `package.json` or tsconfig edit downstream.
    "transit": {
      "dependsOn": ["^transit"]
    },
    "typecheck": {
      "dependsOn": ["transit"],
      // No outputs: `incremental` is off, so tsc leaves no build info to cache
      // (scripts/tests/typescript-incremental.unit.test.ts pins that).
      "inputs": ["$TURBO_ROOT$/tsconfig.json", "$TURBO_DEFAULT$"]
    },
    // Script-less, and the task `bun run check` requests. `transit` selects
    // nothing, so `typecheck` alone would drop the upstream workspaces from a
    // filtered run. This task depends on its own `typecheck` and on those of
    // the workspaces it imports (`^`), which orders only these markers: every
    // `typecheck` still starts at once. Do not select upstream with `with`
    // instead: Turbo stops a `with` task when the task that lists it exits, so a
    // slower workspace's type error is lost and its cache entry never written.
    "typecheck:with-deps": {
      "dependsOn": ["typecheck", "^typecheck:with-deps"]
    },
    "circular": {},
    // A unit test runs the sources of the workspaces it imports, not only its
    // own: a frontend test drives API code, an API test drives `shared`. With
    // no `dependsOn`, the key covered one workspace and replayed a pass after
    // the code under test had changed. `transit` adds the upstream sources to
    // the key without making any lane wait or run another workspace's tests.
    "test:unit": {
      "dependsOn": ["transit"],
      "env": ["DATABASE_PATH", "CI", "MANGOSTUDIO_*"]
    },
    "test:integration": {
      "cache": false,
      "env": ["DATABASE_PATH", "CI", "MANGOSTUDIO_*"]
    },
    // The JUnit reports these lanes write are deliberately not declared as
    // outputs. The task is uncached, so there is nothing to restore, and every
    // workspace writes into one shared directory. Declared, it would give every
    // workspace's task the same glob, and overlapping globs cross-contaminate a
    // restored cache if anyone ever turned caching on here.
    "test:coverage": {
      "cache": false,
      "outputs": ["$TURBO_ROOT$/.mango/artifacts/coverage/**"],
      "env": ["DATABASE_PATH", "CI", "MANGOSTUDIO_*"]
    },
    // This one is cached, so both keys below are load-bearing.
    // `MANGOSTUDIO_BUN_TEST_ARGS` carries `--shard`: without it in the key,
    // shard 2 restores shard 1's entry and runs nothing. And its own JUnit
    // report — one file, no overlap with any other task — has to be restored
    // on a hit, or the shard contributes zero root tests and still looks green.
    // `$TURBO_DEFAULT$` is required too: an explicit `inputs` list replaces
    // Turbo's tracked-file set, and the root tests read `.github/**` and
    // other files outside `scripts/**`. Without it a workflow-only change
    // restores a stale `root.xml`.
    "//#test:scripts": {
      "inputs": ["$TURBO_DEFAULT$", "scripts/**"],
      "outputs": ["$TURBO_ROOT$/.mango/artifacts/junit/root.xml"],
      "env": ["CI", "MANGOSTUDIO_*"]
    },
    // The same tests as `//#test:scripts`, split across worker processes by
    // scripts/run-test-workers.ts (the `bun run test` unit phase; the coverage
    // phase and CI's shards keep the task above, which is the one that writes
    // the coverage evidence `root.xml`). Cached, so the runner and everything
    // it loads are inputs: `scripts/**` covers them, `$TURBO_DEFAULT$` the
    // files the tests read from outside `scripts/`. The merged report is
    // nobody's evidence, so there is no output to restore. The worker count is
    // a pass-through and not an `env` entry: the result is the same at any
    // width, so it stays out of the key. The toolchain homes are pass-through
    // for the launcher that pins them (scripts/lib/test-home.ts).
    "//#test:scripts:workers": {
      "inputs": ["$TURBO_DEFAULT$", "scripts/**"],
      "env": ["CI", "MANGOSTUDIO_*"],
      "passThroughEnv": [
        "CARGO_HOME",
        "RUSTUP_HOME",
        "BUN_INSTALL",
        "BUN_INSTALL_CACHE_DIR",
        "MANGO_TEST_WORKERS"
      ]
    }
  }
}
