{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "interruptible": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": ["VITE_*"]
    },
    "check:quick": {
      "inputs": ["$TURBO_ROOT$/biome.json", "$TURBO_DEFAULT$"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": ["$TURBO_ROOT$/tsconfig.json", "$TURBO_DEFAULT$"],
      "outputs": ["$TURBO_ROOT$/.mango/artifacts/tsbuildinfo/**"]
    },
    "circular": {},
    "test:unit": {
      "env": ["DATABASE_PATH", "CI", "MANGOSTUDIO_*"]
    },
    "test:integration": {
      "cache": false,
      "env": ["DATABASE_PATH", "CI", "MANGOSTUDIO_*"]
    },
    "test:coverage": {
      "cache": false,
      "outputs": ["$TURBO_ROOT$/.mango/artifacts/coverage/**"],
      "env": ["DATABASE_PATH", "CI", "MANGOSTUDIO_*"]
    },
    "//#test:scripts": {
      "inputs": ["scripts/**"]
    }
  }
}
