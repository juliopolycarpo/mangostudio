# ─── OS and logs ─── #
.DS_Store
*.log

# ─── run-tests-watchdog.ts output, when a CI lane is reproduced locally ─── #
# The preserved attempt log no longer ends in `.log`, so `*.log` misses it, and
# the meta file is written into whatever workspace the lane ran from.
*.log.attempt-*
run-meta.json
shard-meta.json

