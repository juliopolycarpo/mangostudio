{
  "name": "mangostudio-dprint-lsp",
  "version": "0.1.0",
  "description": "Project-local dprint LSP for MangoStudio.",
  "author": {
    "name": "MangoStudio"
  },
  "lspServers": {
    "dprint": {
      "command": "dprint",
      "args": ["lsp"],
      "extensionToLanguage": {
        ".md": "markdown",
        ".mdx": "mdx",
        ".toml": "toml",
        ".yml": "yaml",
        ".yaml": "yaml"
      }
    }
  }
}
