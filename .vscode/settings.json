{
  "files.autoSave": "afterDelay",
  "files.autoSaveWhenNoErrors": true,
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "files.eol": "\n",

  "files.exclude": {
    "**/node_modules": true,
    "**/.tsbuildinfo": true,
    "**/dist": true,
    "**/coverage": true,
    "**/playwright-report": true,
    "**/test-results": true,
    "**/.jscpd-out": true,
    "**/.mango/out": true,
    "**/.qa-gate": true,
    "**/bun.lock": true,
    "apps/frontend/src/routeTree.gen.ts": true,
    ".gemini": true,
    ".gitmessage": true,
    ".agents": true,
    ".codex": true
  },

  "editor.formatOnSave": true,
  "editor.formatOnSaveMode": "file",
  "editor.formatOnPaste": true,
  "editor.defaultFormatter": "biomejs.biome",
  "editor.codeActionsOnSave": {
    "source.fixAll.biome": "explicit",
    "source.organizeImports.biome": "explicit"
  },
  "editor.codeActionsOnPaste": {
    "source.fixAll.biome": "explicit",
    "source.organizeImports.biome": "explicit"
  },

  "editor.rulers": [100],
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": true,
  "editor.renderWhitespace": "boundary",
  "editor.linkedEditing": true,
  "breadcrumbs.enabled": true,

  "biome.requireConfiguration": true,
  "biome.lsp.bin": {
    "darwin-arm64": "./node_modules/@biomejs/cli-darwin-arm64/biome",
    "darwin-x64": "./node_modules/@biomejs/cli-darwin-x64/biome",
    "linux-arm64": "./node_modules/@biomejs/cli-linux-arm64/biome",
    "linux-x64": "./node_modules/@biomejs/cli-linux-x64/biome",
    "win32-arm64": "./node_modules/@biomejs/cli-win32-arm64/biome.exe",
    "win32-x64": "./node_modules/@biomejs/cli-win32-x64/biome.exe"
  },

  "[typescript]": { "editor.defaultFormatter": "biomejs.biome" },
  "[typescriptreact]": { "editor.defaultFormatter": "biomejs.biome" },
  "[javascript]": { "editor.defaultFormatter": "biomejs.biome" },
  "[javascriptreact]": { "editor.defaultFormatter": "biomejs.biome" },
  "[json]": { "editor.defaultFormatter": "biomejs.biome" },
  "[jsonc]": { "editor.defaultFormatter": "biomejs.biome" },
  "[css]": { "editor.defaultFormatter": "biomejs.biome" },
  "[html]": { "editor.defaultFormatter": "biomejs.biome" },

  "[markdown]": {
    "editor.defaultFormatter": "dprint.dprint",
    "files.trimTrailingWhitespace": false
  },
  "[mdx]": {
    "editor.defaultFormatter": "dprint.dprint",
    "files.trimTrailingWhitespace": false
  },
  "[toml]": { "editor.defaultFormatter": "dprint.dprint" },
  "[yaml]": { "editor.defaultFormatter": "dprint.dprint" },
  "[dockerfile]": { "editor.defaultFormatter": "dprint.dprint" },

  "dprint.path": "./node_modules/.bin/dprint",

  "js/ts.experimental.useTsgo": true,
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "typescript.preferences.preferTypeOnlyAutoImports": true,
  "typescript.preferences.importModuleSpecifier": "shortest",
  "typescript.disableAutomaticTypeAcquisition": true,
  "typescript.updateImportsOnFileMove.enabled": "always",
  "javascript.updateImportsOnFileMove.enabled": "always",
  "javascript.preferences.importModuleSpecifier": "non-relative",

  "search.exclude": {
    "**/.jscpd-out": true,
    "**/.mango/out": true,
    "**/.qa-gate": true,
    "**/.tsbuildinfo": true,
    "**/bun.lock": true,
    "**/coverage": true,
    "**/dist": true,
    "**/playwright-report": true,
    "**/test-results": true,
    "apps/frontend/src/routeTree.gen.ts": true
  },
  "search.followSymlinks": false,
  "files.watcherExclude": {
    "**/.jscpd-out/**": true,
    "**/.mango/out/**": true,
    "**/.qa-gate/**": true,
    "**/coverage/**": true,
    "**/dist/**": true,
    "**/playwright-report/**": true,
    "**/test-results/**": true
  },
  "typescript.native-preview.tsdk": "./node_modules/@typescript/native-preview",
  "typescript.experimental.useTsgo": true,
  "dprint.experimentalLsp": true,
  "biome.lsp.trace.server": "messages",
  "biome.lsp.watcher.kind": "recommended",
  "git.alwaysSignOff": true,
  "files.autoSaveDelay": 150,
  "files.autoSaveWorkspaceFilesOnly": true,

  "bun.debugTerminal.enabled": true,
  "bun.test.filePattern": "**/*{.test,.spec,_test_,_spec_}{ts,tsx,js,jsx,mts,cts}"
}
