{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreDependencies": ["@dprint/markdown", "@dprint/toml", "@dprint/dockerfile", "jscpd"],
  "treatConfigHintsAsErrors": true,
  "workspaces": {
    ".": {
      "entry": [
        ".claude/hooks/*.mjs",
        ".codex/hooks/*.mjs",
        "scripts/ci/{distribution-identity,evaluate-gate}.ts",
        "scripts/examples/external-api-smoke.ts",
        "scripts/qa-gate/{collect,collect-test-metrics,render-coverage-summary,render-report}.ts",
        "scripts/qa-gate/**/*.unit.test.ts",
        "scripts/qa-gate/publish/*.mjs",
        "scripts/release/{archive-assets,bundle-distribution,distribution-manifest,extract-distribution,fill-dry-run-checksums,pack-npm,prepare-release,publish-npm,push-dist-repo,stage-docker-ctx,update-homebrew,update-scoop,verify-checksum}.ts",
        "scripts/release/*.sh",
        "scripts/tests/**/*.test.ts"
      ],
      "project": [".claude/hooks/*.mjs", ".codex/hooks/*.mjs", "scripts/**/*.{ts,mjs}"]
    },
    "apps/api": {
      "entry": [
        "src/services/providers/cursor/sidecar/{run-agent,sidecar-runtime}.mjs",
        "tests/**/*.{test,integration}.ts",
        "tests/support/fixtures/mcp/echo-stdio-server.ts"
      ],
      "project": ["src/**/*.{ts,mjs}", "tests/**/*.ts"],
      "ignoreBinaries": ["mkfifo"]
    },
    "apps/frontend": {
      "entry": ["tests/**/*.test.{ts,tsx}", "tests/support/setup/motion-react-stub.tsx"],
      "project": ["src/**/*.{ts,tsx}", "tests/**/*.{ts,tsx}", "*.config.ts"],
      "ignoreDependencies": ["tailwindcss"]
    },
    "apps/shared": {
      "entry": ["tests/**/*.test.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "apps/runtime": {
      "entry": ["src/cli.ts", "tests/**/*.test.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "packages/cli": {
      "project": ["bin/**/*.js"]
    }
  }
}
